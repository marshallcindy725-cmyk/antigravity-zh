{
  "// 说明": "antigravity-zh 模式词典：正则规则（仅 DOM 层使用），用于翻译含动态数字/名称的句式。result 中 $1 $2 … 为捕获组回填。规则按顺序匹配，先长后短。",
  "// 注意": "只对整节点文本完整匹配（^...$）时应用，绝不子串替换，保证用户内容安全。",
  "patterns": [
    { "re": "^(\\d+)s ago$", "result": "$1 秒前" },
    { "re": "^(\\d+)m ago$", "result": "$1 分钟前" },
    { "re": "^(\\d+)h ago$", "result": "$1 小时前" },
    { "re": "^(\\d+)d ago$", "result": "$1 天前" },
    { "re": "^(\\d+)w ago$", "result": "$1 周前" },
    { "re": "^just now$", "result": "刚刚" },
    { "re": "^Worked for (\\d+)s$", "result": "运行了 $1 秒" },
    { "re": "^Worked for (\\d+)m$", "result": "运行了 $1 分钟" },
    { "re": "^Worked for (\\d+)h$", "result": "运行了 $1 小时" },
    { "re": "^Thought for (\\d+)s$", "result": "思考了 $1 秒" },
    { "re": "^Thought for (\\d+)m$", "result": "思考了 $1 分钟" },
    { "re": "^Thinking for (\\d+)s$", "result": "思考中，已 $1 秒" },
    { "re": "^Turn (\\d+) of (\\d+)$", "result": "第 $1 轮，共 $2 轮" },
    { "re": "^(\\d+) files changed$", "result": "$1 个文件有改动" },
    { "re": "^(\\d+) file changed$", "result": "$1 个文件有改动" },
    { "re": "^(\\d+) folders changed$", "result": "$1 个文件夹有改动" },
    { "re": "^(\\d+) changes$", "result": "$1 处改动" },
    { "re": "^(\\d+) matches$", "result": "$1 个匹配" },
    { "re": "^(\\d+) match$", "result": "$1 个匹配" },
    { "re": "^(\\d+) results$", "result": "$1 条结果" },
    { "re": "^(\\d+) result$", "result": "$1 条结果" },
    { "re": "^(\\d+) selected$", "result": "已选 $1 项" },
    { "re": "^Wait (\\d+)s$", "result": "等待 $1 秒" },
    { "re": "^(\\d+) steps$", "result": "$1 个步骤" },
    { "re": "^(\\d+) steps?\\. Show plan$", "result": "$1 个步骤。显示计划" },
    { "re": "^(\\d+)/(\\d+) steps$", "result": "$1/$2 步" },
    { "re": "^(\\d+) tools$", "result": "$1 个工具" },
    { "re": "^(\\d+) tools called$", "result": "调用了 $1 个工具" },
    { "re": "^(\\d+) tokens? used$", "result": "已用 $1 个 Token" },
    { "re": "^(\\d+) remaining$", "result": "剩余 $1" },
    { "re": "^Context (\\d+)%", "result": "上下文 $1%" },
    { "re": "^(\\d+)d$", "result": "$1 天" },
    { "re": "^(\\d+)h$", "result": "$1 小时" },
    { "re": "^(\\d+)m$", "result": "$1 分钟" },
    { "re": "^(\\d+)min$", "result": "$1 分钟" },
    { "re": "^every (\\d+) minutes$", "result": "每 $1 分钟" },
    { "re": "^every (\\d+) hours$", "result": "每 $1 小时" },
    { "re": "^once a day$", "result": "每天一次" },
    { "re": "^Copy (\\d+) links?$", "result": "复制 $1 个链接" },
    { "re": "^Showing (\\d+) of (\\d+)$", "result": "显示 $1 / 共 $2" },
    { "re": "^Page (\\d+) of (\\d+)$", "result": "第 $1 页，共 $2 页" },
    { "re": "^(\\d+) participants?$", "result": "$1 位参与者" },
    { "re": "^(\\d+) comments?$", "result": "$1 条评论" },
    { "re": "^(\\d+) messages?$", "result": "$1 条消息" },
    { "re": "^(\\d+) conversations?$", "result": "$1 个对话" },
    { "re": "^(\\d+) conversations? unread$", "result": "$1 个未读对话" },
    { "re": "^(\\d+) agents? running$", "result": "$1 个 Agent 运行中" },
    { "re": "^Max (\\d+)$", "result": "最高 $1" },
    { "re": "^step (\\d+)$", "result": "第 $1 步" },
    { "re": "^Step (\\d+)$", "result": "第 $1 步" },
    { "re": "^Step (\\d+) of (\\d+)$", "result": "第 $1 步，共 $2 步" },
    { "re": "^(\\d+)s$", "result": "$1 秒" }
  ]
}
